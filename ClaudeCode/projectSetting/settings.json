{
  "permissions": {
    "allow": [
      "mcp__chrome-devtools__*",
      "Bash(playwright-cli:*)",
      "Read(./**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(.env.testing)",
      "Read(./.env.testing)",
      "Read(**/.env.testing)",
      "Read(auth.json)",
      "Read(storage/oauth-*.key)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat .env.testing)",
      "Bash(cat ./.env.testing)",
      "Bash(printenv:*)",
      "Bash(env:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh cache delete:*)",
      "Bash(gh gist delete:*)",
      "Bash(gh ssh-key delete:*)",
      "Bash(gh gpg-key delete:*)",
      "Bash(gh label delete:*)",
      "Bash(gh variable delete:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-if-includes:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag -d:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash drop:*)",
      "Bash(git checkout -f:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git filter-branch:*)",
      "Bash(git reflog expire:*)",
      "Bash(git push -d:*)",
      "Bash(git push origin :*)",
      "Bash(git checkout --force:*)",
      "Bash(git switch --force:*)",
      "Bash(git tag --delete:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm -fr:*)",
      "Bash(rm --recursive:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(eval:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "chrome-devtools__",
        "hooks": [
          {
            "type": "command",
            "command": "jq -n --arg ctx \"$(cat \"$CLAUDE_PROJECT_DIR/.claude/hook-rules/qa-browser.md\")\" '{hookSpecificOutput:{hookEventName:\"PreToolUse\",additionalContext:$ctx}}'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(playwright-cli:*)",
            "command": "jq -n --arg ctx \"$(cat \"$CLAUDE_PROJECT_DIR/.claude/hook-rules/qa-browser.md\")\" '{hookSpecificOutput:{hookEventName:\"PreToolUse\",additionalContext:$ctx}}'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "qa-agent",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"${CLAUDE_PROJECT_DIR:?}/.qa-evidence\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "qa-agent",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:?}/.playwright-cli\"; if [ -d \"$d\" ]; then rm -rf \"$d\"; fi"
          }
        ]
      }
    ]
  }
}
